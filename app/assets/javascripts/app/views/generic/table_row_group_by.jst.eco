<tr<% if @groupByValue: %> data-group-by-value="<%= @groupByValue %>"<% end %><% if @collapsible: %> class="js-tableGroupHeader<%= ' is-collapsed' if @collapsed %>" data-group-key="<%= @groupIndex %>" data-group-collapse-key="<%= @collapseKey %>" role="button" tabindex="0" aria-expanded="<%= !@collapsed %>"<% end %>>
  <td colspan="<%= @columnsLength %>">
    <% if @collapsible: %><%- @Icon('arrow-down', 'table-group-by-arrow') %><% end %>
    <b><%- @groupByName %><% if @groupByCount:%> (<%= @groupByCount %>)<% end %></b>
    <% if @groupByActions: %>
      <span class="table-group-by-actions">
        <% for action in @groupByActions: %>
          <span class="btn btn--text btn--secondary <%= action.class %>" data-group-action="<%= action.name %>" title="<%- @Ti(action.title) %>"><%- @Icon(action.icon) %></span>
        <% end %>
      </span>
    <% end %>
  </td>
</tr>
