<li class="overviewSortItem overviewSortItem--folder" data-type="OverviewFolder" data-id="<%= @id %>">
  <div class="overviewSortItem-row">
    <%- @Icon('draggable', 'overviewSortItem-handle') %>
    <svg class="icon overviewSortItem-folderIcon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 4.5A1.5 1.5 0 0 1 3.5 3h2a1.5 1.5 0 0 1 1.06.44L7.62 4.5H12.5A1.5 1.5 0 0 1 14 6v5.5A1.5 1.5 0 0 1 12.5 13h-9A1.5 1.5 0 0 1 2 11.5z"/></svg>
    <span class="overviewSortItem-name u-textTruncate"><%- @T(@name) %></span>
  </div>
  <ul class="js-sortable overviewSortChildren">
    <%- @childrenHtml %>
  </ul>
</li>
